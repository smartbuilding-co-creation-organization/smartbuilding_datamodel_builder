@prefix sbco: <https://www.sbco.or.jp/ont/> .
@prefix sbr: <https://www.sbco.or.jp/ont/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.sbco.or.jp/ont/resource/site-1> a sbco:Site ;
  sbco:id "site-1" ;
  sbco:name "Site A" .

<https://www.sbco.or.jp/ont/resource/bldg-1> a sbco:Building ;
  sbco:id "bldg-1" ;
  sbco:name "Building A" ;
  sbco:isPartOf <https://www.sbco.or.jp/ont/resource/site-1> .

<https://www.sbco.or.jp/ont/resource/floor-1> a sbco:Level ;
  sbco:id "floor-1" ;
  sbco:name "Floor 1" ;
  sbco:isPartOf <https://www.sbco.or.jp/ont/resource/bldg-1> .

<https://www.sbco.or.jp/ont/resource/space-1> a sbco:Room ;
  sbco:id "space-1" ;
  sbco:name "Room 101A" ;
  sbco:isPartOf <https://www.sbco.or.jp/ont/resource/floor-1> .

<https://www.sbco.or.jp/ont/resource/space-2> a sbco:Room ;
  sbco:id "space-2" ;
  sbco:name "Room 102" ;
  sbco:isPartOf <https://www.sbco.or.jp/ont/resource/floor-1> .

<https://www.sbco.or.jp/ont/resource/bldg-2> a sbco:Building ;
  sbco:id "bldg-2" ;
  sbco:name "Building B" ;
  sbco:isPartOf <https://www.sbco.or.jp/ont/resource/site-1> .

<https://www.sbco.or.jp/ont/resource/floor-2> a sbco:Level ;
  sbco:id "floor-2" ;
  sbco:name "Floor 2" ;
  sbco:isPartOf <https://www.sbco.or.jp/ont/resource/bldg-2> .

<https://www.sbco.or.jp/ont/resource/space-3> a sbco:Room ;
  sbco:id "space-3" ;
  sbco:name "Room 201" ;
  sbco:isPartOf <https://www.sbco.or.jp/ont/resource/floor-2> .
